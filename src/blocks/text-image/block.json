{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "starboard/text-image",
  "title": "Text/Image Split",
  "description": "Set an image and words side-by-side for a richer layout.",
  "icon": "align-pull-right",
  "category": "media",
  "keywords": ["text", "columns", "content", "image", "split"],
  "supports": {
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "gradients": true
    },
    "html": false
  },
  "allowedBlocks": ["starboard/text-image-column", "core/image"],
  "attributes": {
    "innerColumnCount": {
      "type": "number",
      "default": 1
    },
    "verticalAlignment": {
      "type": "string",
      "default": "center"
    },
    "selectedVariationTitle": {
      "type": "string",
      "default": ""
    },
    "selectedVariationName": {
      "type": "string",
      "default": ""
    },
    "mobileReverse": {
      "type": "string",
      "default": "image-top-mobile"
    },
    "copySide": {
      "type": "string",
      "default": "split-copy-left"
    },
    "spacing": {
      "type": "object",
      "default": {
        "Default": {
          "active": false,
          "settings": {
            "paddingTop": 16,
            "paddingBottom": 16
          }
        },
        "md": {
          "active": false,
          "settings": {
            "paddingTop": 18,
            "paddingBottom": 18
          }
        },
        "lg": {
          "active": false,
          "settings": {
            "paddingTop": 20,
            "paddingBottom": 20
          }
        },
        "xl": {
          "active": false,
          "settings": {
            "paddingTop": 24,
            "paddingBottom": 24
          }
        }
      }
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./frontend.css"
}
